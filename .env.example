# Jasa server
JASA_TRANSPORT=stdio
JASA_HOST=127.0.0.1
JASA_PORT=8000
JASA_LOG_LEVEL=INFO
JASA_UVLOOP=auto
# Externally reachable base URL. Advertised, never bound -- behind a reverse
# proxy the bind host/port says nothing about how a client reaches you.
# Empty is a working configuration: the MCP icon is inlined as a data URI
# instead of linked. Setting it advertises served icon URLs and a website.
JASA_PUBLIC_URL=
JASA_DOCKER_HOST=127.0.0.1
JASA_DOCKER_PORT=8000
JASA_ENV_FILE=

# REST authentication. JASA_API_KEY takes precedence over the legacy aliases.
JASA_API_KEY=
OPENWEBUI_API_KEY=
OMNISEARCH_API_KEY=

# Request budget. TIMEOUT_MS is the whole-request deadline applied when an MCP
# caller names none of its own. FANOUT_TIMEOUT_MS bounds the provider fan-out
# inside it, so the stages behind the fan-out -- ranking and grounding --
# inherit time rather than whatever the slowest provider happened to leave.
# Handing the fan-out the entire budget starves grounding, which then pays for
# LLM calls it has no time to finish.
JASA_SEARCH_TIMEOUT_MS=50000
JASA_SEARCH_FANOUT_TIMEOUT_MS=25000
# MCP returns this many ranked rows plus eligible tail rescues. Grounding has
# its own lower cap below, so increasing this does not buy more page fetches.
JASA_SEARCH_MAX_RESULTS=50

# Shared search/fetch cache. Redis supports multi-replica deployments.
JASA_CACHE_BACKEND=memory
JASA_CACHE_MAX_ENTRIES=10000
JASA_DISK_CACHE_PATH=.cache/jasa
# Fetched pages are immutable once published, so they are kept for 10 days
# and reused across searches. Site homepages are rolling indexes and expire
# on their own short clock instead; that value never exceeds the one above.
JASA_FETCH_CACHE_TTL_SECONDS=864000
JASA_VOLATILE_FETCH_CACHE_TTL_SECONDS=300
# Successful individual grounding outputs default to a 24-hour TTL.
JASA_GROUNDING_CACHE_TTL_SECONDS=86400
# Provider usage/quota snapshots default to a 10-minute TTL.
JASA_USAGE_CACHE_TTL_SECONDS=600
JASA_REDIS_URL=
# Complete successful search results default to a 36-hour TTL.
JASA_SEARCH_CACHE_TTL_SECONDS=129600

# Grounded snippets. Auto enables grounding when any waterfall tier has its
# credential set. The LLM call walks an ordered waterfall of OpenAI-compatible
# chat-completions endpoints so one rate-limited provider does not discard a
# page fetch that was already paid for. The chain ships in
# src/jasa/grounding/waterfall.yaml; point JASA_GROUNDING_WATERFALL_PATH at
# your own copy to swap providers without rebuilding. The LLM_* values below
# supply the defaults for any tier that omits them.
#
# The deadlines are deliberately generous. Every grounded snippet costs a page
# fetch plus at least one LLM completion, both billed before any deadline can
# fire, so a tight budget does not save money -- it pays for work and then
# discards it. PER_URL_DEADLINE covers a cold fetch through the omnifetch
# provider waterfall AND every LLM tier behind it, so it is a multiple of a
# single tier's LLM_TIMEOUT_MS rather than a peer of it.
JASA_GROUNDING_MODE=auto
JASA_GROUNDING_CONCURRENCY=20
JASA_GROUNDING_PER_URL_DEADLINE_MS=30000
JASA_GROUNDING_TOP_N=20
JASA_GROUNDING_LLM_BASE_URL=https://api.cerebras.ai/v1
JASA_GROUNDING_LLM_MODEL=gpt-oss-120b
JASA_GROUNDING_LLM_TIMEOUT_MS=25000
JASA_GROUNDING_WATERFALL_PATH=
JASA_GROUNDING_MAX_CONTENT_CHARS=48000
CEREBRAS_API_KEY=

# Composition switches
JASA_EXPOSE_HELLO=false

# OpenTelemetry. Leave the exporter empty or set it to none to disable tracing.
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=jasa
OTEL_TRACES_EXPORTER=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Search-provider credentials. Shared search/fetch credentials belong here.
TAVILY_API_KEY=
BRAVE_API_KEY=
KAGI_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
PERPLEXITY_API_KEY=
SERPAPI_API_KEY=
LINKUP_API_KEY=
YOU_API_KEY=
PARALLEL_API_KEY=
SERPER_API_KEY=
ANTHROPIC_AUTH_TOKEN=
OPENAI_API_KEY=
Z_AI_API_KEY=
SCRAPFLY_API_KEY=

# Search-provider settings. These are not credentials and activate nothing on
# their own, and leaving them alone is a working configuration. The Claude and
# Codex defaults target this project's own gateway; the Z.AI default goes to
# the vendor directly at api.z.ai, because no gateway fronts it. Set an
# endpoint and its model together to retarget an adapter at the vendor
# (https://api.anthropic.com, or https://api.openai.com/v1 with an official id
# such as gpt-5.6) or at another compatible endpoint. A dated model id is
# eventually retired upstream, so review the default against the vendor
# deprecation page.
ANTHROPIC_BASE_URL=https://ai.angrist.net
CLAUDE_SEARCH_MODEL=claude-haiku-4-5-20251001
OPENAI_BASE_URL=https://ai.angrist.net/v1
CODEX_SEARCH_MODEL=gpt-5.6-luna
ZAI_SEARCH_MODEL=glm-4.6
Z_AI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Fetch-provider credentials. Shared search/fetch credentials appear above.
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_ZONE=unblocker
CRW_API_KEY=
DECODO_WEB_SCRAPING_API_KEY=
DIFFBOT_TOKEN=
GITHUB_API_KEY=
JINA_API_KEY=
KIMI_API_KEY=
LEADMAGIC_API_KEY=
OLOSTEP_API_KEY=
OPENGRAPH_IO_API_KEY=
OXYLABS_WEB_SCRAPER_USERNAME=
OXYLABS_WEB_SCRAPER_PASSWORD=
SCRAPE_DO_API_TOKEN=
SCRAPEGRAPHAI_API_KEY=
SCRAPELESS_API_KEY=
SCRAPERAPI_API_KEY=
SCRAPINGANT_API_KEY=
SCRAPINGBEE_API_KEY=
SCRAPPEY_API_KEY=
SOCIAVAULT_API_KEY=
SPIDER_CLOUD_API_TOKEN=
SUPADATA_API_KEY=
ZYTE_API_KEY=
