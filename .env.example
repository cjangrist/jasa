# Jasa server
JASA_TRANSPORT=stdio
JASA_HOST=127.0.0.1
JASA_PORT=8000
JASA_LOG_LEVEL=INFO
JASA_UVLOOP=auto
JASA_DOCKER_HOST=127.0.0.1
JASA_DOCKER_PORT=8000

# REST authentication. JASA_API_KEY takes precedence over the legacy aliases.
JASA_API_KEY=
OPENWEBUI_API_KEY=
OMNISEARCH_API_KEY=

# Search-result cache. Redis is reserved for future multi-replica support.
JASA_CACHE_BACKEND=memory
JASA_DISK_CACHE_PATH=.cache/jasa
JASA_REDIS_URL=

# Grounded snippets. Auto enables grounding only when CEREBRAS_API_KEY is set.
JASA_GROUNDING_MODE=auto
JASA_GROUNDING_CONCURRENCY=10
JASA_GROUNDING_PER_URL_DEADLINE_MS=7500
JASA_GROUNDING_TOP_N=20
JASA_GROUNDING_LLM_BASE_URL=https://api.cerebras.ai/v1
JASA_GROUNDING_LLM_MODEL=gpt-oss-120b
JASA_GROUNDING_LLM_TIMEOUT_MS=60000
JASA_GROUNDING_MAX_CONTENT_CHARS=24000
CEREBRAS_API_KEY=

# Composition switches
JASA_EXPOSE_HELLO=false

# OpenTelemetry. Leave the exporter empty or set it to none to disable tracing.
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=jasa
OTEL_TRACES_EXPORTER=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Search-provider credentials
TAVILY_API_KEY=
BRAVE_API_KEY=
KAGI_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
PERPLEXITY_API_KEY=
SERPAPI_API_KEY=
LINKUP_API_KEY=
YOU_API_KEY=
PARALLEL_API_KEY=

# Fetch-provider credentials. Shared search/fetch credentials appear above.
BRIGHT_DATA_API_KEY=
DECODO_WEB_SCRAPING_API_KEY=
DIFFBOT_TOKEN=
GITHUB_API_KEY=
JINA_API_KEY=
KIMI_API_KEY=
LEADMAGIC_API_KEY=
OLOSTEP_API_KEY=
OPENGRAPH_IO_API_KEY=
OXYLABS_WEB_SCRAPER_USERNAME=
OXYLABS_WEB_SCRAPER_PASSWORD=
SCRAPE_DO_API_TOKEN=
SCRAPEGRAPHAI_API_KEY=
SCRAPELESS_API_KEY=
SCRAPERAPI_API_KEY=
SCRAPFLY_API_KEY=
SCRAPINGANT_API_KEY=
SCRAPINGBEE_API_KEY=
SCRAPPEY_API_KEY=
SOCIAVAULT_API_KEY=
SPIDER_CLOUD_API_TOKEN=
SUPADATA_API_KEY=
ZYTE_API_KEY=

# Omnifetch composed mode. These are read but inert when Omnifetch is mounted.
# Jasa supplies the shared HTTP client and always forces the child REST route off.
OMNIFETCH_HTTP_LIMIT_PER_HOST=20
OMNIFETCH_HTTP_TRANSIENT_RETRIES=0
OMNIFETCH_REST_WEB_FETCH=false

# Standalone Omnifetch process settings are also inert when mounted.
OMNIFETCH_TRANSPORT=stdio
OMNIFETCH_HOST=127.0.0.1
OMNIFETCH_PORT=8000
OMNIFETCH_LOG_LEVEL=INFO
OMNIFETCH_CACHE_BACKEND=memory
OMNIFETCH_REDIS_URL=
OMNIFETCH_DISK_CACHE_PATH=.cache/omnifetch
OMNIFETCH_UVLOOP=auto

# Test control. Leave empty for the normal unit suite.
JASA_RUN_DOCKER_TESTS=
